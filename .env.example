# ===================================
# Hệ thống phân tích cổ phiếu Việt Nam - Mẫu cấu hình biến môi trường
# Sao chép file này thành .env rồi điền cấu hình thật
# ===================================

# Danh sách mã theo dõi (phân tách bằng dấu phẩy), ví dụ mã HOSE / HNX / UPCOM
STOCK_LIST=HPG,FPT,VCB

# Anspire Open API Keys (hỗ trợ nhiều key, phân tách bằng dấu phẩy)
# Đăng ký: https://open.anspire.cn/?share_code=QFBC0FYC
# Khi chưa cấu hình nguồn OpenAI-compatible ưu tiên cao hơn, key này có thể được dùng lại
# cho cả cổng LLM của Anspire lẫn tìm kiếm tin tức.
# Gateway và model dưới đây chỉ là ví dụ; khả dụng hay không tuỳ console và tài liệu chính thức của Anspire:
# Gateway ví dụ: https://open-gateway.anspire.cn/v6
# Model ví dụ: Doubao-Seed-2.0-lite (có thể ghi đè ANSPIRE_LLM_MODEL=Doubao-Seed-2.0-pro)
# Nếu gateway khác vùng/phiên bản, có thể ghi đè ANSPIRE_LLM_BASE_URL=https://open-gateway.anspire.ai/v6
ANSPIRE_API_KEYS=
# ANSPIRE_LLM_MODEL=Doubao-Seed-2.0-lite
# ANSPIRE_LLM_BASE_URL=https://open-gateway.anspire.cn/v6
# ANSPIRE_LLM_ENABLED=true

# ===================================
# Cấu hình mô hình AI
# ===================================
# Hướng dẫn đầy đủ: docs/LLM_CONFIG_GUIDE_EN.md
#
# [Bắt đầu nhanh] Chỉ cần điền một API Key là chạy được, hệ thống tự nhận diện model.
#   Anspire Open (model + tìm kiếm) -> điền ANSPIRE_API_KEYS
#   Gemini (có hạn mức miễn phí)     -> điền GEMINI_API_KEY
#   DeepSeek (giá tốt)               -> điền DEEPSEEK_API_KEY
#   AIHubmix (nền tảng tổng hợp)     -> điền AIHUBMIX_KEY
#
# [Nâng cao] Cần nhiều model / fallback giữa nhiều nền tảng -> cấu hình "đa kênh" bên dưới
# hoặc quản lý trực quan trên trang Cài đặt Web.
# Mỗi kênh có thể chọn rõ LLM_<CHANNEL>_API_SURFACE là chat_completions (mặc định) hoặc responses.
# responses yêu cầu PROTOCOL=openai và MODELS không được dùng tiền tố provider LiteLLM trực tiếp
# như anthropic/, gemini/, xai/; model ID có dấu gạch chéo của gateway (vd deepseek-ai/DeepSeek-V3)
# được định tuyến như model ID OpenAI-compatible.
# Cùng một alias model đã chuẩn hoá không được xuất hiện đồng thời ở kênh chat_completions và responses.
# Các model trong cùng một kênh phải dùng cùng một API Surface; đừng trông chờ tự đổi endpoint khi lỗi.
# Nếu `/models` của Anspire và kiểm tra kết nối xác nhận model đi qua Responses (vd GPT-5.6 sol/terra/luna),
# hãy dùng chế độ kênh và đặt LLM_ANSPIRE_API_SURFACE=responses.
# ===================================

# Backend sinh nội dung: mặc định litellm; codex_cli / claude_code_cli / opencode_cli là backend CLI cục bộ
# phải bật tường minh (experimental/limited).
# OpenCode CLI dùng model mặc định của OpenCode trên máy; OPENCODE_CLI_MODEL chỉ là tuỳ chọn ghi đè --model.
# Backend CLI cục bộ KHÔNG đồng nghĩa với model offline: dịch vụ phía sau CLI có thể xử lý mã cổ phiếu,
# tin tức, ngữ cảnh danh mục, prompt phân tích và bản nháp báo cáo.
# Docker / CI / remote server không sẵn có trạng thái đăng nhập CLI trên desktop; DSA không đọc file
# credential của Claude/OpenCode.
# DSA dùng env allowlist tối thiểu + denylist credential provider để giảm rủi ro lộ API key / webhook token.
# Kiểm tra nhanh trên trang Cài đặt chỉ đọc cấu hình và kiểm tra file thực thi; chỉ "JSON test" mới gửi
# request smoke thật tới generation backend.
GENERATION_BACKEND=litellm
# OPENCODE_CLI_MODEL=provider/model
# Fallback cấp backend; giá trị rỗng trong .env cục bộ sẽ tắt fallback, litellm -> litellm được coi là no-op.
# Workflow GitHub Actions mặc định dùng litellm khi biến này chưa cấu hình; muốn tắt fallback trên
# Actions thì đặt bằng primary backend (self no-op).
GENERATION_FALLBACK_BACKEND=litellm
# Giới hạn thực thi backend CLI cục bộ; timeout tối đa 3600, output tối đa 33554432 bytes,
# độ song song tối đa lần lượt 16 / 4.
GENERATION_BACKEND_TIMEOUT_SECONDS=300
GENERATION_BACKEND_MAX_OUTPUT_BYTES=1048576
GENERATION_BACKEND_MAX_CONCURRENCY=1
LOCAL_CLI_BACKEND_MAX_CONCURRENCY=1
# Cách chạy Chat hỏi cổ phiếu; auto (khuyến nghị) và litellm giữ đường model mặc định hiện tại,
# codex_app_server gọi Codex trên máy chạy backend DSA (thử nghiệm, chỉ single-agent Chat trên
# macOS/Linux/WSL đầy đủ; chưa hỗ trợ Windows gốc). Trang Cài đặt chỉ kiểm tra có thể thử hay không,
# câu hỏi thật đầu tiên mới xác minh đăng nhập, model và thực thi công cụ.
AGENT_BACKEND=auto
# Mục tương thích định tuyến model Agent cũ; người dùng thông thường hãy dùng AGENT_BACKEND trên trang Cài đặt.
AGENT_GENERATION_BACKEND=auto

# --- API Key (điền một cái là đủ) ---

# Gemini (https://aistudio.google.com)
GEMINI_API_KEY=
# Cân bằng tải nhiều key: GEMINI_API_KEYS=key1,key2,key3

# DeepSeek (https://platform.deepseek.com)
# Tương thích mặc định: chỉ điền DEEPSEEK_API_KEY thì vẫn dùng deepseek-chat và log sẽ gợi ý chuyển sang deepseek-v4-flash
# DEEPSEEK_API_KEY=

# AIHubmix tổng hợp (https://inferera.com/?aff=CfMq)
# Một key dùng được GPT/Claude/Gemini/GLM/Qwen...
# AIHUBMIX_KEY=

# Anthropic Claude (https://console.anthropic.com)
# ANTHROPIC_API_KEY=

# OpenAI / API tương thích
# OPENAI_API_KEY=
# OPENAI_BASE_URL=                     # Địa chỉ API bên thứ ba (proxy/relay); để trống dùng chính thức

# Model cục bộ Ollama (không cần API Key)
# OLLAMA_API_BASE=http://localhost:11434
# LITELLM_MODEL=ollama/qwen3:8b
#
# Hoặc dùng chế độ kênh:
# LLM_CHANNELS=ollama
# LLM_OLLAMA_BASE_URL=http://localhost:11434
# LLM_OLLAMA_MODELS=qwen3:8b

# Nhiệt độ lấy mẫu (0.0-2.0, mặc định 0.7; 0 ổn định nhất, 2 ngẫu nhiên nhất)
# Nguồn tham chiếu về tương thích temperature nghiêm ngặt:
# - Moonshot API / tài liệu model: https://platform.kimi.ai/docs/guide/kimi-k2-6-quickstart
# - Model card chính thức của Moonshot (đánh giá mặc định temperature = 1.0): https://huggingface.co/moonshotai/Kimi-K2.6
# - Đặc tả OpenAI Chat Completions: https://platform.openai.com/docs/api-reference/chat/create
# - Đặc tả LiteLLM OpenAI-Compatible: https://docs.litellm.ai/docs/providers/openai_compatible
# Ràng buộc phụ thuộc runtime hiện tại: litellm>=1.80.10,!=1.82.7,!=1.82.8,<1.99.0 (xem requirements.txt).
# Vì vậy kimi-k2.6 tự dùng 1.0/0.6; các model mặc định temperature như GPT-5 / dòng o sẽ bỏ qua temperature
# để tránh API từ chối request.
# Nếu nền tảng tương thích trả về lỗi tham số không được hỗ trợ, runtime sẽ sửa tham số trong request hiện tại
# và thử lại một lần; chiến lược thành công chỉ được cache trong tiến trình.
# top_p, presence_penalty, frequency_penalty, seed cũng được sửa và thử lại ở mức request
# (không ghi đè LLM_TEMPERATURE).
# Các model khác và fallback vẫn dùng LLM_TEMPERATURE bạn cấu hình.
# Trang Cài đặt Web / import trên desktop không âm thầm xoá hoặc ghi đè LLM_TEMPERATURE.
# LLM_TEMPERATURE=0.7

# Cấu hình HMAC cho telemetry mức sử dụng LLM (tuỳ chọn)
# Để trống thì hệ thống tự tạo .llm_usage_hmac_secret trong thư mục dữ liệu, so sánh ổn định trong cùng một triển khai.
# Chỉ cấu hình tường minh cùng một khoá ngẫu nhiên khi cần so sánh HMAC giữa nhiều triển khai;
# khi xoay khoá hãy cập nhật nhãn phiên bản.
# Dùng giá trị ngẫu nhiên entropy cao (vd openssl rand -hex 32), không commit khoá thật.
# LLM_USAGE_HMAC_SECRET=
# LLM_USAGE_HMAC_KEY_VERSION=local-v1

# Cấu hình prompt cache của provider (tuỳ chọn)
# TELEMETRY chỉ điều khiển việc ghi nhận usage / diagnostics của cache; không điều khiển implicit cache của provider.
# HINTS điều khiển việc chủ động gửi các hint riêng của provider (prompt_cache_key, cache_control, user_id...); mặc định tắt.
# DIAGNOSTICS_LEVEL: off/basic/debug; debug cũng chỉ in chẩn đoán đã che thông tin nhạy cảm.
# LLM_PROMPT_CACHE_TELEMETRY_ENABLED=true
# LLM_PROMPT_CACHE_HINTS_ENABLED=false
# LLM_PROMPT_CACHE_DIAGNOSTICS_LEVEL=off

# --- Cấu hình đa kênh (tuỳ chọn, cũng có thể cấu hình trên trang Cài đặt Web) ---
# Mỗi kênh cấu hình độc lập base_url / api_key / models, hỗ trợ xoay vòng nhiều key và tự động fallback.
#
# Ví dụ: hai kênh DeepSeek + Gemini
# LLM_CHANNELS=deepseek,gemini
# LLM_DEEPSEEK_API_KEY=sk-xxx
# LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro
# LLM_GEMINI_API_KEYS=key1,key2
# LLM_GEMINI_MODELS=gemini-3.1-pro-preview
#
# Ví dụ: endpoint API tuỳ chỉnh (proxy bên thứ ba / nền tảng tổng hợp / relay)
# LLM_CHANNELS=my_proxy
# LLM_MY_PROXY_BASE_URL=https://your-proxy.example.com/v1
# LLM_MY_PROXY_API_KEY=sk-xxx
# LLM_MY_PROXY_MODELS=gpt-5.5,claude-sonnet-4-6
# LLM_MY_PROXY_PROTOCOL=openai
#
# Ví dụ: model cục bộ Ollama (không cần API Key)
# LLM_CHANNELS=ollama
# LLM_OLLAMA_BASE_URL=http://localhost:11434
# LLM_OLLAMA_MODELS=qwen3:8b,llama3.2
#
# Ví dụ: Hermes HTTP generation cục bộ (chỉ phân tích thường/JSON; không hỗ trợ Agent tools, Stream, Vision)
# LLM_CHANNELS=hermes
# LLM_HERMES_PROTOCOL=openai
# LLM_HERMES_BASE_URL=http://127.0.0.1:8642/v1
# LLM_HERMES_API_KEY=sk-local-hermes
# LLM_HERMES_MODELS=hermes-agent
# LITELLM_MODEL=openai/hermes-agent
#
# Mẫu cấu hình các nhà cung cấp phổ biến (chọn một rồi chép vào .env; chi tiết xem docs/llm-providers.md)
#
# Anspire Open (dùng chung key tìm kiếm và LLM, OpenAI Compatible)
# LLM_CHANNELS=anspire
# LLM_ANSPIRE_PROTOCOL=openai
# LLM_ANSPIRE_BASE_URL=https://open-gateway.anspire.cn/v6 (ví dụ)
# LLM_ANSPIRE_API_KEY=sk-xxx
# LLM_ANSPIRE_MODELS=Doubao-Seed-2.0-lite,Doubao-Seed-2.0-pro (model ví dụ)
# LITELLM_MODEL=openai/Doubao-Seed-2.0-lite (ví dụ)
#
# AIHubmix (OpenAI Compatible)
# LLM_CHANNELS=aihubmix
# LLM_AIHUBMIX_PROTOCOL=openai
# LLM_AIHUBMIX_BASE_URL=https://aihubmix.com/v1
# LLM_AIHUBMIX_API_KEY=sk-xxx
# LLM_AIHUBMIX_MODELS=gpt-5.5,claude-sonnet-4-6,gemini-3.1-pro-preview
# LITELLM_MODEL=openai/gpt-5.5
#
# OpenAI chính thức
# LLM_CHANNELS=openai
# LLM_OPENAI_PROTOCOL=openai
# LLM_OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_OPENAI_API_KEY=sk-xxx
# LLM_OPENAI_MODELS=gpt-5.5,gpt-5.4-mini
# LITELLM_MODEL=openai/gpt-5.5
#
# DeepSeek chính thức
# LLM_CHANNELS=deepseek
# LLM_DEEPSEEK_PROTOCOL=deepseek
# LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_DEEPSEEK_API_KEY=sk-xxx
# LLM_DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro
# LITELLM_MODEL=deepseek/deepseek-v4-flash
#
# Gemini chính thức (giao thức chính thức, để trống Base URL)
# LLM_CHANNELS=gemini
# LLM_GEMINI_PROTOCOL=gemini
# LLM_GEMINI_API_KEY=xxx
# LLM_GEMINI_MODELS=gemini-3.1-pro-preview,gemini-3-flash-preview
# LITELLM_MODEL=gemini/gemini-3.1-pro-preview
#
# Anthropic Claude chính thức (giao thức chính thức, để trống Base URL)
# LLM_CHANNELS=anthropic
# LLM_ANTHROPIC_PROTOCOL=anthropic
# LLM_ANTHROPIC_API_KEY=sk-ant-xxx
# LLM_ANTHROPIC_MODELS=claude-sonnet-4-6,claude-opus-4-7
# LITELLM_MODEL=anthropic/claude-sonnet-4-6
#
# Kimi / Moonshot (OpenAI Compatible)
# LLM_CHANNELS=moonshot
# LLM_MOONSHOT_PROTOCOL=openai
# LLM_MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# LLM_MOONSHOT_API_KEY=sk-xxx
# LLM_MOONSHOT_MODELS=kimi-k2.6,kimi-k2.5
# LITELLM_MODEL=openai/kimi-k2.6
#
# Qwen DashScope (OpenAI Compatible)
# LLM_CHANNELS=dashscope
# LLM_DASHSCOPE_PROTOCOL=openai
# LLM_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_DASHSCOPE_API_KEY=sk-xxx
# LLM_DASHSCOPE_MODELS=qwen3.6-plus,qwen3.6-flash
# LITELLM_MODEL=openai/qwen3.6-plus
#
# Zhipu GLM (OpenAI Compatible)
# LLM_CHANNELS=zhipu
# LLM_ZHIPU_PROTOCOL=openai
# LLM_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_ZHIPU_API_KEY=xxx
# LLM_ZHIPU_MODELS=glm-5.1,glm-4.7-flash
# LITELLM_MODEL=openai/glm-5.1
#
# MiniMax LLM (OpenAI Compatible) - chỉ là kênh LLM, không phải nhà cung cấp tìm kiếm
# Nguồn: tài liệu tương thích OpenAI API chính thức https://platform.minimax.io/docs/api-reference/text-chat
# LLM_CHANNELS=minimax
# LLM_MINIMAX_PROTOCOL=openai
# LLM_MINIMAX_BASE_URL=https://api.minimax.io/v1
# LLM_MINIMAX_API_KEY=xxx
# LLM_MINIMAX_MODELS=MiniMax-M2.7,MiniMax-M2.7-highspeed
# LITELLM_MODEL=openai/MiniMax-M2.7
#
# Xiaomi MiMo (OpenAI Compatible) - Base URL và tên model theo tài liệu/console chính thức của MiMo.
# LLM_CHANNELS=mimo
# LLM_MIMO_PROTOCOL=openai
# LLM_MIMO_BASE_URL=
# LLM_MIMO_API_KEY=sk-xxx
# LLM_MIMO_MODELS=mimo-xxx
# LITELLM_MODEL=openai/mimo-xxx
# Lưu ý: workflow daily_analysis mặc định không truyền LLM_MIMO_*; ví dụ này dành cho .env cục bộ,
# Docker hoặc script tự host; dùng trên Actions thì cần bổ sung ánh xạ trong workflow.
#
# Volcengine Ark / Doubao (OpenAI Compatible, điều chỉnh endpoint theo vùng đã mở)
# Nguồn: https://www.volcengine.com/docs/82379/2121998
# LLM_CHANNELS=volcengine
# LLM_VOLCENGINE_PROTOCOL=openai
# LLM_VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_VOLCENGINE_API_KEY=xxx
# LLM_VOLCENGINE_MODELS=doubao-seed-1-6-251015,doubao-seed-1-6-thinking-251015
# LITELLM_MODEL=openai/doubao-seed-1-6-251015
#
# SiliconFlow (OpenAI Compatible)
# Nguồn: https://docs.siliconflow.cn/quickstart/models
# LLM_CHANNELS=siliconflow
# LLM_SILICONFLOW_PROTOCOL=openai
# LLM_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# LLM_SILICONFLOW_API_KEY=sk-xxx
# LLM_SILICONFLOW_MODELS=deepseek-ai/DeepSeek-V3.2,Qwen/Qwen3-235B-A22B-Thinking-2507
# LITELLM_MODEL=openai/deepseek-ai/DeepSeek-V3.2
#
# OpenRouter (OpenAI Compatible)
# Nguồn: https://openrouter.ai/docs/api/api-reference/models/get-models
# LLM_CHANNELS=openrouter
# LLM_OPENROUTER_PROTOCOL=openai
# LLM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM_OPENROUTER_API_KEY=sk-or-xxx
# LLM_OPENROUTER_MODELS=~anthropic/claude-sonnet-latest,~openai/gpt-latest
# LITELLM_MODEL=openai/~anthropic/claude-sonnet-latest

# Nâng cao: cấu hình định tuyến model bằng YAML (tuỳ chọn, tham khảo docs/examples/litellm_config.example.yaml)
# LITELLM_CONFIG=./litellm_config.yaml

# ===================================
# Cấu hình công cụ tìm kiếm (lấy tin tức cổ phiếu)
# ===================================
# [Khuyến nghị cho thị trường Việt Nam]
#   - Khuyến nghị TAVILY_API_KEYS: có hạn mức miễn phí, hướng tới LLM/Agent, dùng được với từ khoá tiếng Việt.
#   - Đừng dựa vào SEARXNG_PUBLIC_INSTANCES_ENABLED: hầu hết instance công khai không mở JSON API, trong khi
#     provider SearXNG của dự án bắt buộc format=json. Muốn dùng SearXNG hãy tự host và cấu hình SEARXNG_BASE_URLS.
#   - ANSPIRE_API_KEYS cũng được dùng làm kênh cổng LLM (xem src/config.py), hãy cân nhắc trước khi cấu hình.
#   - Một nguồn bổ sung khác là kho tin cục bộ (RSS, xem NEWS_INTEL_* bên dưới), không cần key, nguồn tiếng Việt.
# Tavily API Keys (hỗ trợ nhiều key, phân tách bằng dấu phẩy)
TAVILY_API_KEYS=
# SerpAPI Keys (hỗ trợ nhiều key, phân tách bằng dấu phẩy)
SERPAPI_API_KEYS=
# Brave Search API Keys (hỗ trợ nhiều key, phân tách bằng dấu phẩy)
# Đăng ký: https://brave.com/search/api/
BRAVE_API_KEYS=
# Địa chỉ instance SearXNG (phân tách bằng dấu phẩy; tự host không giới hạn hạn mức, cần bật format: json trong settings.yml)
# Workflow phân tích hằng ngày trên GitHub Actions ưu tiên Variables cùng tên, sau đó mới tới Secrets;
# địa chỉ công khai có thể cấu hình dạng Variable.
# Để trống và bật công tắc bên dưới thì hệ thống tự lấy instance công khai từ searx.space. Instance công khai
# thường bị giới hạn (429), ngừng hoạt động (503) hoặc không bật JSON, thử lần lượt sẽ làm mỗi lượt phân tích
# chậm thêm 30~60 giây mà tin tức vẫn rỗng, vì vậy mặc định tắt.
SEARXNG_BASE_URLS=
SEARXNG_PUBLIC_INSTANCES_ENABLED=false
# Timeout mỗi lượt tìm kiếm SearXNG tự host (giây, mặc định 10, tối thiểu 1); không áp dụng cho instance công khai
SEARXNG_TIMEOUT_SECONDS=10

# ===================================
# Độ mới tin tức và lọc phân tích
# ===================================
# Cửa sổ chiến lược tin tức: ultra_short(1 ngày) / short(3 ngày) / medium(7 ngày) / long(30 ngày)
# Cửa sổ thực tế = min(cửa sổ chiến lược, NEWS_MAX_AGE_DAYS)
# NEWS_STRATEGY_PROFILE=short
# Tuổi tối đa của tin tức (ngày), tránh dùng thông tin đã cũ
# NEWS_MAX_AGE_DAYS=3
# Số ngày lưu kho tin cục bộ; chỉ dọn intelligence_items, không ảnh hưởng báo cáo lịch sử
# NEWS_INTEL_RETENTION_DAYS=30
# Timeout lấy một nguồn RSS/Atom (giây)
# NEWS_INTEL_FETCH_TIMEOUT_SEC=8
# Số bài tối đa thu thập mỗi nguồn trong một lượt
# NEWS_INTEL_MAX_ITEMS_PER_SOURCE=50
# Khi bật, trước khi phân tích mã, phân tích Agent và tổng quan thị trường đọc kho tin cục bộ, hệ thống sẽ tự
# khởi tạo các nguồn có sẵn và lấy tin từ các nguồn đang bật.
# Dự án có sẵn các mẫu RSS tiếng Việt (CafeF / VnExpress / Vietstock, market=vn), không cần API key.
# Có thời gian chờ 60 phút trong tiến trình, không gửi request ra ngoài cho từng mã.
# Lưu ý: workflow daily_analysis mặc định không truyền biến này; dùng trên Actions cần bổ sung ánh xạ.
NEWS_INTEL_AUTO_FETCH_ENABLED=true
# Địa chỉ gốc HTTP API của NewsNow (phụ thuộc bên ngoài)
# - Dự án và hướng dẫn triển khai: https://github.com/qqhann/newsnow
# - Giá trị mặc định là instance công khai mẫu, có thể không ổn định; môi trường production nên tự host.
# - Xem thêm docs/intelligence-sources.md
# NEWSNOW_BASE_URL=https://newsnow.busiyi.world
# Ngưỡng độ lệch (%) so với MA5; vượt quá sẽ cảnh báo không mua đuổi; cổ phiếu xu hướng mạnh được nới lên 1.5 lần
# BIAS_THRESHOLD=5.0

# ===================================
# Cấu hình hội thoại chiến lược Agent (trang Chat Web)
# ===================================
# Bật hội thoại chiến lược Agent (mặc định false, nội bộ gọi là skill)
# AGENT_MODE=true
# Model chính cho Chat hỏi cổ phiếu (tuỳ chọn): để trống thì kế thừa model chính;
# không có tiền tố provider sẽ được hiểu là openai/<model>; Codex không dùng mục này
# AGENT_LITELLM_MODEL=
# Giới hạn tài nguyên Agent: với model mặc định là số bước suy luận tối đa; với Codex là số lần gọi công cụ tối đa
# AGENT_MAX_STEPS=10
#
# Danh sách skill chiến lược có sẵn (kết hợp tuỳ ý):
#   bull_trend, ma_golden_cross, volume_breakout, hot_theme, event_driven, growth_quality,
#   expectation_repricing, shrink_pullback, bottom_volume, dragon_head, one_yang_three_yin,
#   box_oscillation, chan_theory, wave_theory, emotion_cycle
#
# Để trống thì dùng skill mặc định khai báo trong metadata (mặc định có sẵn là bull_trend)
# Chỉ định thủ công: AGENT_SKILLS=bull_trend,ma_golden_cross,shrink_pullback
# Bật tất cả: AGENT_SKILLS=all
AGENT_SKILLS=
# Thư mục chiến lược tuỳ chỉnh (tuỳ chọn, chứa file YAML chiến lược)
# AGENT_SKILL_DIR=./strategies

# Kiến trúc Agent (mặc định single; multi là chế độ điều phối nhiều Agent)
# AGENT_ARCH=single

# Chế độ điều phối Multi-Agent (chỉ có hiệu lực khi AGENT_ARCH=multi)
# quick: kỹ thuật -> quyết định (nhanh nhất)
# standard: kỹ thuật -> tin tức -> quyết định (mặc định)
# full: kỹ thuật -> tin tức -> rủi ro -> quyết định
# specialist: kỹ thuật -> tin tức -> rủi ro -> chuyên gia chiến lược -> quyết định
# AGENT_ORCHESTRATOR_MODE=standard

# Ngân sách thời gian thực thi Agent (giây; đường LiteLLM có thể đặt 0 để tắt; Codex phải > 0; mặc định 600)
# AGENT_ORCHESTRATOR_TIMEOUT_S=600

# Giới hạn timeout riêng cho từng Agent con (giây, 0 = tắt)
#   - Khi tắt ngân sách tổng (AGENT_ORCHESTRATOR_TIMEOUT_S=0): giới hạn Agent con là timeout tuyệt đối
#   - Khi bật ngân sách tổng: giới hạn thực tế = min(ngân sách còn lại, giới hạn Agent con)
# AGENT_TECHNICAL_AGENT_TIMEOUT_S=0
# AGENT_INTEL_AGENT_TIMEOUT_S=0
# AGENT_RISK_AGENT_TIMEOUT_S=0
# AGENT_DECISION_AGENT_TIMEOUT_S=0
# AGENT_PORTFOLIO_AGENT_TIMEOUT_S=0
# AGENT_SKILL_AGENT_TIMEOUT_S=0

# Timeout mặc định theo nhóm công cụ Agent (giây, 0 = tắt; chưa cấu hình thì dùng ngân sách tool_call_timeout_seconds)
# Thứ tự ưu tiên: tool_call_timeout_seconds theo lượt > timeout_seconds của từng công cụ > mặc định theo nhóm > không giới hạn.
# Công cụ nhóm market dùng chung AGENT_DATA_TOOL_TIMEOUT_S.
# AGENT_DATA_TOOL_TIMEOUT_S=0
# AGENT_SEARCH_TOOL_TIMEOUT_S=0
# AGENT_ANALYSIS_TOOL_TIMEOUT_S=0
# AGENT_ACTION_TOOL_TIMEOUT_S=0

# Số chuyên gia chiến lược chạy song song (chỉ chế độ specialist; 1-4, mặc định 3)
# AGENT_SKILL_CONCURRENCY=3

# Agent rủi ro có được phủ quyết tín hiệu mua hay không (mặc định bật)
# AGENT_RISK_OVERRIDE=true

# Hệ thống ghi nhớ và hiệu chỉnh (theo dõi độ chính xác lịch sử, tự điều chỉnh độ tin cậy)
# AGENT_MEMORY_ENABLED=false

# Gán trọng số thận trọng cho ý kiến chiến lược dựa trên Skill Outcome thực tế đủ mẫu
# AGENT_SKILL_AUTOWEIGHT=true

# Chế độ định tuyến chiến lược (auto = tự chọn theo trạng thái thị trường / manual = dùng danh sách AGENT_SKILLS)
# AGENT_SKILL_ROUTING=auto

# Nén ngữ cảnh hội thoại hiển thị của Chat (mặc định tắt). Chỉ nén lịch sử user/assistant hiển thị.
# AGENT_CONTEXT_COMPRESSION_ENABLED=false
# Chiến lược nén: cost = tiết kiệm token / balanced = cân bằng / long_context_raw_first = giữ nhiều nguyên văn hơn
# AGENT_CONTEXT_COMPRESSION_PROFILE=balanced
# Ngưỡng token lịch sử để kích hoạt nén; để trống thì theo preset của profile
# AGENT_CONTEXT_COMPRESSION_TRIGGER_TOKENS=
# Giữ nguyên văn N lượt người dùng gần nhất; để trống thì theo preset của profile
# AGENT_CONTEXT_PROTECTED_TURNS=

# Giám sát cảnh báo sự kiện (chạy nền ở chế độ schedule; khi kích hoạt sẽ dùng lại các kênh thông báo đã cấu hình)
# JSON legacy chỉ hỗ trợ ba loại quy tắc đơn mã; quy tắc chỉ báo kỹ thuật, danh mục, tài khoản, thị trường
# hãy cấu hình trong Trung tâm cảnh báo Web/API.
#   price_cross          - giá vượt ngưỡng, direction: above / below, trường: price
#   price_change_percent - % thay đổi vượt ngưỡng, direction: up / down, trường: change_pct (đơn vị %)
#   volume_spike         - khối lượng tăng đột biến, trường: multiplier (bội số so với trung bình 20 phiên)
# AGENT_EVENT_MONITOR_ENABLED=false
# AGENT_EVENT_MONITOR_INTERVAL_MINUTES=5
# AGENT_EVENT_ALERT_RULES_JSON=[{"stock_code":"HPG","alert_type":"price_cross","direction":"above","price":30000},{"stock_code":"FPT","alert_type":"price_change_percent","direction":"down","change_pct":3.0},{"stock_code":"VCB","alert_type":"volume_spike","multiplier":2.5}]

# ===================================
# Cấu hình kênh thông báo (có thể cấu hình nhiều kênh, tất cả đều nhận thông báo)
# ===================================
#
# [Cách 1] Telegram bot (cần cả hai mục)
# 1. Tìm @BotFather trên Telegram -> /newbot -> lấy Bot Token
# 2. Lấy Chat ID: nhắn cho @userinfobot hoặc truy cập https://api.telegram.org/bot<token>/getUpdates
#
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=123456789
# TELEGRAM_MESSAGE_THREAD_ID=2780
#
# [Cách 2] Email (chỉ cần 2 mục, SMTP tự nhận diện)
# Hỗ trợ Gmail và các hộp thư hỗ trợ SMTP với mật khẩu ứng dụng / xác thực cơ bản.
# Outlook / Exchange nếu tenant bắt buộc OAuth2 thì hiện chưa hỗ trợ.
#
# EMAIL_SENDER=
# EMAIL_PASSWORD=
# EMAIL_RECEIVERS=receiver@example.com  # Tuỳ chọn, để trống thì gửi cho chính mình
#
# [Mở rộng cách 2] Gửi nhóm mã tới các hộp thư khác nhau (Issue #268, tuỳ chọn)
# STOCK_LIST quyết định phạm vi phân tích; STOCK_GROUP_N chỉ quyết định email gửi cho ai, nên là tập con của STOCK_LIST.
# Các kênh khác (Telegram / Webhook...) vẫn gửi theo toàn bộ STOCK_LIST.
# Workflow daily_analysis mặc định không tự truyền STOCK_GROUP_N / EMAIL_GROUP_N;
# tính năng này dành cho .env cục bộ, Docker hoặc môi trường đã truyền các biến này.
# STOCK_GROUP_1=HPG,FPT
# EMAIL_GROUP_1=user1@example.com
# STOCK_GROUP_2=VCB,TCB
# EMAIL_GROUP_2=user2@example.com
#
# [Cách 3] Webhook tuỳ chỉnh (hỗ trợ nhiều URL, phân tách bằng dấu phẩy)
# Dùng cho Discord, Slack, Bark, dịch vụ tự host... bất kỳ webhook nào nhận POST JSON
# Hệ thống tự nhận diện các dịch vụ phổ biến và dùng định dạng tương ứng
#
# CUSTOM_WEBHOOK_URLS=https://api.day.app/YOUR_BARK_KEY,https://hooks.slack.com/services/xxx
# CUSTOM_WEBHOOK_BEARER_TOKEN=  # Tuỳ chọn, cho webhook cần xác thực (Header Authorization: Bearer <token>)
# CUSTOM_WEBHOOK_BODY_TEMPLATE=  # Tuỳ chọn, mẫu JSON body toàn cục, ghi đè payload tự động; khuyến nghị $content_json/$title_json
# Khi viết tay .env cho Docker Compose hãy viết $$content_json/$$title_json; trang Cài đặt Web tự escape, runtime vẫn khôi phục thành một $
# WEBHOOK_VERIFY_SSL=true   # Mặc định kiểm tra chứng chỉ HTTPS; đặt false để hỗ trợ chứng chỉ tự ký. CẢNH BÁO: tắt sẽ có rủi ro MITM, chỉ dùng trong mạng nội bộ tin cậy
#
# [Cách 4] Pushover
# Đăng ký tài khoản Pushover và tạo Application Token tại https://pushover.net/apps/build
# PUSHOVER_USER_KEY=
# PUSHOVER_API_TOKEN=
#
# [Cách 5] ntfy
# NTFY_URL phải chứa topic path, ví dụ https://ntfy.sh/my-topic hoặc https://self-hosted:port/my-topic
# NTFY_URL=
# NTFY_TOKEN=  # Tuỳ chọn, cho topic cần Bearer Token hoặc ntfy server tự host
#
# [Cách 6] Gotify
# GOTIFY_URL là địa chỉ gốc của Gotify server, không chứa /message; hệ thống tự nối /message và gửi token qua header X-Gotify-Key.
# GOTIFY_URL=
# GOTIFY_TOKEN=  # Gotify application token
#
# [Cách 7] Discord
# Hai cách: Webhook (khuyến nghị, cấu hình đơn giản) và Bot API
#
# Cách 7a: Discord Webhook
# Cài đặt kênh -> Integrations -> Webhooks -> New Webhook -> Copy URL
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
#
# Cách 7b: Discord Bot API (cần tài khoản bot và ID kênh)
# 1. Tạo bot: https://discord.com/developers/applications -> New Application -> Bot
# 2. Lấy Bot Token: trang Bot -> Reset Token
# 3. Lấy ID kênh: bật Developer Mode -> chuột phải vào kênh -> Copy ID
# DISCORD_BOT_TOKEN=
# DISCORD_MAIN_CHANNEL_ID=
# DISCORD_CHANNEL_ID=   # Tên biến cũ để tương thích, khuyến nghị dùng DISCORD_MAIN_CHANNEL_ID
# DISCORD_MAX_WORDS=2000 # Giới hạn 2000 ký tự mỗi tin; báo cáo dài sẽ được chia nhỏ
# Nếu nhận callback Discord Interaction / Webhook, bắt buộc cấu hình public key để xác thực chữ ký
# Lấy tại: Discord Developer Portal -> General Information -> Public Key
# DISCORD_INTERACTIONS_PUBLIC_KEY=
# DISCORD_BOT_STATUS=Phân tích cổ phiếu VN | Vietnam stock analysis | /help
#
# [Cách 8] Slack
# Hai cách: Bot API (khuyến nghị) và Incoming Webhook; cấu hình cả hai thì ưu tiên Bot API.
#
# Cách 8a: Slack Bot API (hỗ trợ tải ảnh lên)
# 1. Tạo Slack App: https://api.slack.com/apps -> Create New App
# 2. Thêm Bot Token Scopes: chat:write, files:write
# 3. Cài vào workspace và lấy Bot Token (xoxb-...)
# 4. Lấy ID kênh: chi tiết kênh -> cuối trang
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_ID=C01234567
#
# Cách 8b: Slack Incoming Webhook (đơn giản, không hỗ trợ tải ảnh)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx
#
# [Markdown sang ảnh] (Issue #455)
# Với kênh không hỗ trợ Markdown, chuyển báo cáo thành ảnh để dễ đọc
# MARKDOWN_TO_IMAGE_CHANNELS=telegram,custom,email,slack   # Phân tách bằng dấu phẩy
# MARKDOWN_TO_IMAGE_MAX_CHARS=15000   # Vượt quá độ dài này thì không chuyển, tránh ảnh quá lớn
# MD2IMG_ENGINE=wkhtmltoimage   # wkhtmltoimage (mặc định) | markdown-to-file | playwright
# Công cụ chuyển ảnh: wkhtmltopdf (apt install wkhtmltopdf / brew install wkhtmltopdf) hoặc markdown-to-file
#
# [Định tuyến thông báo] (Issue #1200 P3)
# Để trống: loại thông báo đó gửi tới mọi kênh đã cấu hình. Điền giá trị thì chỉ gửi tới các kênh được liệt kê.
# Giá trị hợp lệ: telegram,email,pushover,ntfy,gotify,custom,discord,slack
# NOTIFICATION_REPORT_CHANNELS=
# NOTIFICATION_ALERT_CHANNELS=
# NOTIFICATION_SYSTEM_ERROR_CHANNELS=
#
# [Giảm nhiễu thông báo] (Issue #1200 P4)
# Mặc định tắt toàn bộ; chỉ áp dụng cho kênh thông báo tĩnh.
# NOTIFICATION_DEDUP_TTL_SECONDS=0      # Cùng một khoá chống trùng chỉ gửi một lần trong TTL; 0 = tắt
# NOTIFICATION_COOLDOWN_SECONDS=0       # Giới hạn tần suất theo khoá cooldown; 0 = tắt
# NOTIFICATION_QUIET_HOURS=             # Khung giờ im lặng, định dạng HH:MM-HH:MM, hỗ trợ qua nửa đêm
# NOTIFICATION_TIMEZONE=                # Múi giờ cho khung im lặng, vd Asia/Ho_Chi_Minh; để trống theo TZ hệ thống
# NOTIFICATION_MIN_SEVERITY=            # info,warning,error,critical; để trống giữ nguyên hành vi
# NOTIFICATION_DAILY_DIGEST_ENABLED=false  # Mục dự trữ; hiện chưa gửi bản tóm tắt hằng ngày
#
# [Tải trước giá realtime] (Issue #455)
# PREFETCH_REALTIME_QUOTES=true   # Đặt false để tắt tải trước giá realtime theo lô

# ===================================
# Cấu hình gửi theo từng mã (tuỳ chọn)
# ===================================
# Chế độ gửi từng mã: phân tích xong mã nào gửi ngay mã đó, thay vì gửi gộp
# SINGLE_STOCK_NOTIFY=false
#
# Loại báo cáo: simple (gọn), full (đầy đủ), brief (tóm tắt 3-5 câu)
# REPORT_TYPE=simple
# Ngôn ngữ báo cáo. Hiện chỉ hỗ trợ tiếng Việt vi (mặc định vi); giá trị cũ không còn hỗ trợ sẽ quy về vi.
# REPORT_LANGUAGE=vi
# Chỉ gửi bản tóm tắt: đặt true để chỉ gửi phần tổng hợp, không gửi chi tiết từng mã
# REPORT_SUMMARY_ONLY=false
# Hiển thị tên model LLM đã dùng ở cuối báo cáo; đặt false để ẩn
# REPORT_SHOW_LLM_MODEL=true
#
# Report Engine P0 (Jinja2 / kiểm tra toàn vẹn / so sánh lịch sử)
# REPORT_TEMPLATES_DIR=templates
# REPORT_RENDERER_ENABLED=false
# REPORT_INTEGRITY_ENABLED=true
# REPORT_INTEGRITY_RETRY=1
# REPORT_HISTORY_COMPARE_N=0

# Gộp báo cáo phân tích mã và tổng quan thị trường vào một thông báo (mặc định false), giảm số email
# MERGE_EMAIL_NOTIFICATION=false

# ===================================
# Khoảng nghỉ giữa các lượt phân tích (tuỳ chọn)
# ===================================
# Độ trễ (giây) giữa phân tích từng mã và phân tích thị trường, tránh bị giới hạn tần suất API AI
# ANALYSIS_DELAY=0

# Đường dẫn cơ sở dữ liệu
DATABASE_PATH=./data/stock_analysis.db
# Tối ưu ghi SQLite: mặc định bật WAL, giảm tranh chấp khoá khi ghi theo lô và ghi đồng thời
SQLITE_WAL_ENABLED=true
# Timeout chờ khoá SQLite (mili giây)
SQLITE_BUSY_TIMEOUT_MS=5000
# Số lần thử lại tối đa khi gặp database is locked / database table is locked
SQLITE_WRITE_RETRY_MAX=3
# Thời gian chờ cơ sở khi thử lại ghi SQLite (giây, tăng theo hàm mũ)
SQLITE_WRITE_RETRY_BASE_DELAY=0.1

# Snapshot ngữ cảnh phân tích: đặt false để không lưu toàn bộ context_snapshot
SAVE_CONTEXT_SNAPSHOT=true

# ===================================
# Cấu hình backtest (tuỳ chọn)
# ===================================
# Bật backtest (true/false)
BACKTEST_ENABLED=true
# Cửa sổ đánh giá backtest (số phiên giao dịch)
BACKTEST_EVAL_WINDOW_DAYS=10
# Chỉ backtest các bản phân tích cũ hơn N ngày (tránh dữ liệu gần đây chưa đầy đủ)
BACKTEST_MIN_AGE_DAYS=14
# Phiên bản engine backtest (phân biệt kết quả khi logic backtest thay đổi)
BACKTEST_ENGINE_VERSION=v1
# Ngưỡng vùng trung tính (%), vd 2 nghĩa là -2%~+2% được coi là đi ngang
BACKTEST_NEUTRAL_BAND_PCT=2.0

# === Cấu hình tác vụ định kỳ ===
# Bật tác vụ định kỳ (true/false)
SCHEDULE_ENABLED=false
# Giờ chạy hằng ngày (HH:MM, 24 giờ)
SCHEDULE_TIME=18:00
# Danh sách nhiều giờ chạy (phân tách bằng dấu phẩy; để trống thì dùng SCHEDULE_TIME)
SCHEDULE_TIMES=
# Timeout cứng cho một lượt phân tích của runtime scheduler Web/API (giây, tối thiểu 60)
DSA_RUNTIME_SCHEDULER_TIMEOUT_SECONDS=2700
# Sau khi hết timeout cứng có gửi thông báo hoàn thành một phần cho các mã đã lưu hay không (mặc định true)
DSA_TIMEOUT_PARTIAL_NOTIFY=true
# Chế độ định kỳ có chạy ngay một lượt khi khởi động hay không (true/false)
# Nếu không đặt, chế độ định kỳ dùng lại ngữ nghĩa ghi đè của RUN_IMMEDIATELY để tương thích cấu hình cũ
SCHEDULE_RUN_IMMEDIATELY=true
# Chế độ không định kỳ có chạy ngay một lượt khi khởi động hay không (true/false)
RUN_IMMEDIATELY=true
# Bật tổng quan thị trường (true/false)
MARKET_REVIEW_ENABLED=true
# Đưa tóm tắt bối cảnh thị trường vào prompt phân tích từng mã và bật rào chắn thận trọng (mặc định bật)
DAILY_MARKET_CONTEXT_ENABLED=true
# Vùng tổng quan thị trường: chỉ hỗ trợ vn (Việt Nam)
MARKET_REVIEW_REGION=vn
# Màu tăng/giảm chỉ số trong tổng quan: green_up = xanh tăng đỏ giảm (mặc định), red_up = đỏ tăng xanh giảm
# MARKET_REVIEW_COLOR_SCHEME=green_up

# ===================================
# Cấu hình proxy (tuỳ chọn)
# ===================================
# Bật proxy (true/false, mặc định false); chỉ áp dụng khi chạy cục bộ, GitHub Actions tự bỏ qua
USE_PROXY=false
# Địa chỉ proxy (mặc định 127.0.0.1)
PROXY_HOST=127.0.0.1
# Cổng proxy (mặc định 10809)
PROXY_PORT=10809

# Cấu hình hệ thống
# Thư mục log
LOG_DIR=./logs
# Mức log (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO
# Mức log nội bộ của LiteLLM (mặc định WARNING; có thể tạm đặt DEBUG khi điều tra streaming/định tuyến)
# LITELLM_LOG_LEVEL=WARNING
# Số luồng song song tối đa (nên giữ thấp để tránh bị chặn)
MAX_WORKERS=3
# Bật log debug
DEBUG=false

# ===================================
# Cấu hình WebUI (tuỳ chọn)
# ===================================
# Khởi động WebUI mặc định (true/false, mặc định false)
WEBUI_ENABLED=false
# Địa chỉ lắng nghe WebUI (mặc định 127.0.0.1; Docker/máy chủ cloud cần 0.0.0.0, xem docs/deploy-webui-cloud.md)
WEBUI_HOST=127.0.0.1
# Cổng WebUI (mặc định 8000)
WEBUI_PORT=8000
# Tự build frontend trước khi khởi động Web (npm install && npm run build, mặc định true)
WEBUI_AUTO_BUILD=true
# Sau một reverse proxy tin cậy (vd Nginx -> App) thì tin X-Forwarded-For để lấy IP thật (lấy giá trị ngoài cùng bên phải)
# phục vụ giới hạn đăng nhập; khi mở trực tiếp ra Internet hãy giữ false để tránh giả mạo
# TRUST_X_FORWARDED_FOR=false

# ===================================
# Xác thực đăng nhập Web (tuỳ chọn)
# ===================================
# Đặt true để bật bảo vệ bằng mật khẩu; lần truy cập đầu sẽ đặt mật khẩu ban đầu
# Quên mật khẩu: chạy trên máy chủ `python -m src.auth reset_password`
ADMIN_AUTH_ENABLED=false
# ADMIN_SESSION_MAX_AGE_HOURS=24  # Thời hạn session (giờ)

# ===========================================
# Nhận diện mã cổ phiếu từ ảnh (trang Cài đặt "Thêm từ ảnh")
# ===========================================
# Timeout mỗi request 60 giây; ảnh tối đa 5MB
# Cần cấu hình ít nhất một trong GEMINI_API_KEY, ANTHROPIC_API_KEY hoặc OPENAI_API_KEY (model có Vision)

# ===========================================
# Thị trường được bật
# ===========================================
# Nguồn duy nhất: src/core/markets.py
# Chỉ hỗ trợ thị trường Việt Nam (vn). Giá trị khác sẽ bị bỏ qua kèm cảnh báo, không làm tiến trình dừng.
SUPPORTED_MARKETS=vn

# ===========================================
# Nguồn dữ liệu Việt Nam (VCI / SSI / vnstock)
# ===========================================
# VCI và SSI đều là HTTP API công khai, không cần API Key và không cần thêm phụ thuộc.
#   - VciFetcher: giá ngày + chỉ số + bảng mã đầy đủ (trading.vietcap.com.vn)
#   - SsiFetcher: snapshot realtime toàn thị trường + giá ngày dự phòng (iboard-query/iboard-api.ssi.com.vn)
#
# Số càng nhỏ càng được ưu tiên
# VCI_PRIORITY=0
# SSI_PRIORITY=1
#
# Timeout mỗi request (giây) và khoảng cách tối thiểu giữa các request (giây, tránh bị chặn)
# VCI_CALL_TIMEOUT=20
# VCI_MIN_INTERVAL=0.6
# SSI_CALL_TIMEOUT=20
# SSI_MIN_INTERVAL=0.5
#
# Ghi đè địa chỉ API (khi dùng proxy / mirror tự host)
# VCI_BASE_URL=https://trading.vietcap.com.vn
# SSI_QUERY_BASE_URL=https://iboard-query.ssi.com.vn
# SSI_CHART_BASE_URL=https://iboard-api.ssi.com.vn
#
# Thứ tự nguồn giá realtime; token hợp lệ: fiintrade / ssi / vci
#   fiintrade chỉ có hiệu lực khi FiinTrade đang chạy (có FIINTRADE_ORIGIN); không ghi thì tự đứng đầu
REALTIME_SOURCE_PRIORITY=ssi,vci
#
# --- FiinTrade (mặc định bật, chỉ chạy khi có FIINTRADE_ORIGIN) ---
# Nến ngày cổ phiếu HOSE / HNX / UPCOM, ETF và chỉ số (gồm UPCoM-Index) qua API biểu đồ FiinTrade,
# đứng TRƯỚC VCI khi bật.
# Khi bật còn đứng đầu chuỗi giá realtime (token fiintrade trong REALTIME_SOURCE_PRIORITY):
#   P/E, P/B, vốn hoá, EPS, ROE, khối ngoại, thoả thuận, trần/sàn; và cổ tức TTM, phát hành,
#   giao dịch nội bộ cho khối fundamentals. Giá realtime của chỉ số rơi sang VCI.
#   - Server chỉ trả dữ liệu cho Origin nằm trong whitelist của đối tác (thiếu thì 403),
#     nên phải điền FIINTRADE_ORIGIN được cấp; thiếu origin thì fetcher không chạy (như cũ).
#   - Tắt hẳn dù đã có origin: FIINTRADE_ENABLED=false.
#   - Giá đã điều chỉnh quyền, cùng cơ sở với VCI nên được ghi stock_daily.
#   - API nhận organCode chứ không phải ticker (VHM -> NHN, ACV -> ACVN): fetcher tra danh mục
#     Master/GetListOrganization (cache 24 giờ). Mã không tra được thì tự chuyển sang VCI.
#   - Không có giá trị giao dịch: amount ước lượng = (high+low)/2 × volume.
#   - Chỉ dùng khi tổ chức của bạn được FiinTrade cho phép gọi API từ máy chủ.
# FIINTRADE_ORIGIN=
# FIINTRADE_ENABLED=true
# FIINTRADE_PRIORITY=-1
# FIINTRADE_CALL_TIMEOUT=20
# FIINTRADE_MIN_INTERVAL=0.3
# FIINTRADE_BASE_URL=https://wlgw-technical.fiintrade.vn
# Máy chủ dữ liệu thị trường (chỉ số, độ rộng, dòng tiền khối ngoại / tự doanh cho điểm lại thị trường)
# FIINTRADE_MARKET_BASE_URL=https://wlgw-market.fiintrade.vn
# Máy chủ danh mục mã (bảng ticker -> organCode)
# FIINTRADE_CORE_BASE_URL=https://wlgw-core.fiintrade.vn

# --- YFinance là nguồn dự phòng thứ ba cho thị trường Việt Nam (mặc định bật, không cần cấu hình) ---
# Chỉ được gọi khi cả VCI và SSI đều lỗi, lấy giá ngày cổ phiếu HOSE qua hậu tố .VN.
#   - Chỉ có HOSE: HNX / UPCOM / chỉ số Việt Nam không có dữ liệu trên Yahoo
#   - Giá ngày không ghi vào stock_daily: chuẩn điều chỉnh giá của Yahoo và VCI khác nhau
#     (MBB đo được chênh hệ số cố định 1.043938 trước ngày GDKHQ), trộn vào sẽ tạo khoảng trống giá giả ~4.4%
# CẢNH BÁO: đừng đặt YFINANCE_PRIORITY trước SSI_PRIORITY: Yahoo thiếu HNX / UPCOM / chỉ số,
#   nếu bị dùng làm nguồn chính thì các mã này sẽ lỗi hàng loạt.
# YFINANCE_PRIORITY=4

# --- vnstock (tuỳ chọn, mặc định tắt) ---
# CẢNH BÁO: giấy phép của vnstock là "Custom (Personal Use)", không phải giấy phép mã nguồn mở:
#      https://vnstocks.com/onboard/giay-phep-su-dung
#    Nó còn kéo theo vnai, gửi dữ liệu sử dụng về phía tác giả.
#    Vì vậy nó không nằm trong requirements.txt, cần cài riêng:
#      pip install -r requirements-vn-optional.txt
#    Hãy xác nhận mục đích sử dụng phù hợp với giấy phép trước khi bật.
# VNSTOCK_ENABLED=false
# VNSTOCK_PRIORITY=2
# VNSTOCK_SOURCE=VCI

# --- Feed giá realtime MQTT TVSI (tuỳ chọn, mặc định tắt) ---
# Nhận giá khớp lệnh theo từng tick để cảnh báo giá mã VN được đánh giá ngay khi giá thay đổi,
# đồng thời đẩy giá live và cảnh báo lên Web (SSE). Cần bật cùng AGENT_EVENT_MONITOR_ENABLED=true.
# Khi feed mất kết nối, cảnh báo tự quay về SSI theo chu kỳ kiểm tra.
#   - Broker TVSI nhận MQTT thuần trên TLS cổng 443 (TVSI_MQTT_TRANSPORT=tcp); WebSocket bị từ chối.
#   - Chỉ subscribe topic giá theo mã (topic/{symbol}); wildcard # / + bị chặn.
#   - Không commit thông tin đăng nhập: chỉ điền trong .env local.
REALTIME_FEED_ENABLED=false
# REALTIME_FEED_STALE_SECONDS=30
# TVSI_MQTT_HOST=realtime-mobile.tvsi.com.vn
# TVSI_MQTT_PORT=443
# TVSI_MQTT_TLS=true
# TVSI_MQTT_TRANSPORT=tcp
# TVSI_MQTT_USERNAME=
# TVSI_MQTT_PASSWORD=
# TVSI_MQTT_TOPIC_TEMPLATE=topic/{symbol}

# ===========================================
# Tăng cường giá realtime và phân tích cơ bản
# ===========================================
# Bật giá realtime (tắt thì dùng giá đóng cửa lịch sử để phân tích)
# ENABLE_REALTIME_QUOTE=true

# Chỉ báo kỹ thuật realtime trong phiên: bật thì tính MA/xu hướng theo giá realtime (Issue #234); tắt thì dùng giá đóng cửa hôm trước
# ENABLE_REALTIME_TECHNICAL_INDICATORS=true

# Bật tổng hợp dữ liệu cơ bản
# ENABLE_FUNDAMENTAL_PIPELINE=true

# Tham số hiệu năng và ổn định của tổng hợp dữ liệu cơ bản (đơn vị: giây)
# FUNDAMENTAL_STAGE_TIMEOUT_SECONDS=8.0
# FUNDAMENTAL_FETCH_TIMEOUT_SECONDS=8.0
# FUNDAMENTAL_RETRY_MAX=1
# FUNDAMENTAL_CACHE_TTL_SECONDS=120
# FUNDAMENTAL_CACHE_MAX_ENTRIES=256

# ===========================================
# Danh mục đầu tư: ngưỡng rủi ro (danh mục chỉ dùng VND)
# ===========================================
# PORTFOLIO_RISK_CONCENTRATION_ALERT_PCT=35.0
# PORTFOLIO_RISK_DRAWDOWN_ALERT_PCT=15.0
# PORTFOLIO_RISK_STOP_LOSS_ALERT_PCT=10.0
# PORTFOLIO_RISK_STOP_LOSS_NEAR_RATIO=0.8
# PORTFOLIO_RISK_LOOKBACK_DAYS=180
